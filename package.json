{
  "name": "@extensio/uca",
  "version": "0.1.0",
  "description": "Universal Cognitive Architecture (UCA) - Reactive, fractal, and deterministic state-action primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    }
  },
  "workspaces": [
    "src/core",
    "src/collection/capabilities/*",
    "src/collection/ucas/*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christian-marino-alvarez/uca-specification.git"
  },
  "keywords": [
    "uca",
    "agentic",
    "cognitive-architecture",
    "capability",
    "reactive",
    "fractal"
  ],
  "author": "Christian Marino Alvarez",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.12.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.5"
  }
}
