    "@uca/heading": "^0.1.0",
    "@uca/paragraph": "^0.1.0",
    "@uca/access": "^0.1.0",
    "@uca/choice": "^0.1.0",
    "@uca/toggle": "^0.1.0",
    "@uca/range": "^0.1.0",
    "@uca/quantity": "^0.1.0",
    "@uca/moment": "^0.1.0",
    "@uca/symbol": "^0.1.0",
    "@uca/status": "^0.1.0",
    "@uca/progress": "^0.1.0",
    "@uca/separator": "^0.1.0"
