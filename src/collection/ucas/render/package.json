{
  "name": "@uca/render",
  "version": "0.1.0",
  "description": "Render UCA for orchestrating web components and spatial presentations",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./schema.js": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
