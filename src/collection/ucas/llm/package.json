{
  "name": "@uca/llm",
  "version": "0.1.0",
  "description": "UCA LLM cognitive reasoning and language model orchestration",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./recovery": {
      "types": "./recovery.d.ts",
      "import": "./recovery.js",
      "default": "./recovery.ts"
    }
  },
  "dependencies": {
    "@uca/core": "^0.1.0",
    "@uca/capability-http-client": "^0.1.0",
    "@uca/capability-sse-client": "^0.1.0",
    "@uca/capability-zod": "^0.1.0",
    "@uca/capability-llm": "^0.1.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "tsx tests/index.ts && tsx tests/recovery.ts"
  }
}
