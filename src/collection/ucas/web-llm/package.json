{
  "name": "@uca/web-llm",
  "version": "0.1.0",
  "description": "Unified Web LLM UCA orchestrating local and external language model streams",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./schema.js": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    }
  },
  "dependencies": {
    "@uca/capability-api-prompt": "^0.1.0",
    "@uca/core": "^0.1.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  }
