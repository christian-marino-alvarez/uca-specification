{
  "name": "@uca/scaffold-composer",
  "version": "0.1.0",
  "description": "UCA ScaffoldComposer interprets application intent and defines minimal conceptual architecture with styles",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./schema": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    },
    "./schema.js": {
      "types": "./schema.d.ts",
      "import": "./schema.js",
      "default": "./schema.ts"
    }
  },
  "dependencies": {
    "@uca/capability-graph": "^0.1.0",
    "@uca/core": "^0.1.0",
    "@uca/llm-web": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  }
}
