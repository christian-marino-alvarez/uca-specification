{
  "name": "@uca/capability-graph",
  "version": "0.1.0",
  "description": "Graph management and persistence capability for UCA",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./schemas": {
      "types": "./schemas/index.d.ts",
      "import": "./schemas/index.js",
      "default": "./schemas/index.ts"
    },
    "./schemas/*": {
      "types": "./schemas/*.d.ts",
      "import": "./schemas/*.js",
      "default": "./schemas/*.ts"
    }
  },
  "dependencies": {
    "@uca/core": "^0.1.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  }
}
