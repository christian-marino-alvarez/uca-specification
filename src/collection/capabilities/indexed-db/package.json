{
  "name": "@uca/capability-indexed-db",
  "version": "0.1.0",
  "description": "Transactional asynchronous IndexedDB storage capability",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
