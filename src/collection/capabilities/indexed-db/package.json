      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    }
  },
  "dependencies": {
    "@uca/core": "^0.1.0"
  }
}
