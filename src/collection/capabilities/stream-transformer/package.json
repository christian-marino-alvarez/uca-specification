{
  "name": "@uca/capability-stream-transformer",
  "version": "0.1.0",
  "description": "Transform incoming text streams into validated object chunk streams",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./parser": {
      "types": "./parser.d.ts",
      "import": "./parser.js",
      "default": "./parser.ts"
    },
    "./parser.js": {
      "types": "./parser.d.ts",
      "import": "./parser.js",
      "default": "./parser.ts"
    }
  },
  "dependencies": {
    "@uca/core": "^0.1.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  }
}
