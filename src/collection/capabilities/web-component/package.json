{
  "name": "@uca/capability-web-component",
  "version": "0.1.0",
  "description": "Primitive native Custom Element capability for Light DOM interaction and rendering",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./types.js": {
      "types": "./types.d.ts",
      "import": "./types.js",
      "default": "./types.ts"
    },
    "./constants": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    },
    "./constants.js": {
      "types": "./constants.d.ts",
      "import": "./constants.js",
      "default": "./constants.ts"
    }
  },
  "dependencies": {
    "@uca/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^28.1.0"
  },
  "scripts": {
    "test": "tsx tests/index.ts"
  }
